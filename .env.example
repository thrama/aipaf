# =============================================================================
# AIPAF — AI Project Assessment Framework
# .env.example — Variabili d'ambiente necessarie
#
# Copia questo file in .env e compila i valori:
#   cp .env.example .env
#
# .env è nel .gitignore e NON deve mai essere committato.
#
# Viene caricato automaticamente da CLI e notebook (python-dotenv) dalla
# cartella corrente; le variabili già presenti nell'ambiente hanno la precedenza.
# =============================================================================

# -----------------------------------------------------------------------------
# Anthropic Claude (richiesto solo se usi --llm claude)
# Ottieni la chiave su: https://console.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Modello Claude (default: claude-sonnet-4-6). Override senza toccare il codice.
# AIPAF_CLAUDE_MODEL=claude-sonnet-4-6

# Gestione temperature: auto (default) | off
# In "auto" il provider passa temperature=0.1 e la disabilita da solo se il
# modello la rifiuta. "off" non la passa mai.
# AIPAF_CLAUDE_TEMPERATURE=auto

# -----------------------------------------------------------------------------
# Ollama (opzionale — default: http://localhost:11434)
# Cambia solo se Ollama gira su un host o porta diversi
# -----------------------------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434

# -----------------------------------------------------------------------------
# AIPAF config (opzionale)
# Default: il JSON impacchettato in aipaf/config/AIPAF_framework_config.json
# Impostare solo per usare un framework personalizzato.
# -----------------------------------------------------------------------------
# AIPAF_CONFIG_PATH=/percorso/AIPAF_framework_config.json

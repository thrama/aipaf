# Normalizza i fine riga nel repository (LF); il checkout segue la piattaforma.
* text=auto

# Sorgenti e testo: sempre LF nel repo
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.ipynb text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.env.example   text eol=lf

# Binari
*.pdf   binary
*.docx  binary
*.gguf  binary
*.png   binary

# Il notebook è generato/rigenerato: non mostrarlo nei diff delle PR su GitHub
*.ipynb linguist-generated=true -diff
